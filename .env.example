# Supabase "Connect -> ORMs -> SQLAlchemy / psycopg2" connection string.
# Shared pool (port 5432) works for this low-traffic app; transaction pool also fine.
DATABASE_URL=postgresql://postgres.yourref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Optional knobs
# MAX_RESULTS=50
# ENRICH_MAX_SITES=10
# RATE_LIMIT_PER_IP=30
# OVERPASS_DEADLINE=25
# OVERPASS_RETRIES=1